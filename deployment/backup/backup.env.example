# Copy to /etc/sia-planb/backup.env, then: chmod 600 /etc/sia-planb/backup.env
# Also keep a copy of this file (and the restic password) in the club password
# manager so a host loss does not block a restore.

# Restic repository. Examples:
#   Backblaze B2:  b2:sia-planb-backups:/sia-planb
#   Second server: sftp:backup@backup.example.com:/srv/restic/sia-planb
RESTIC_REPOSITORY=b2:sia-planb-backups:/sia-planb

# Root-owned file (mode 0600) containing the restic repository password.
# Losing both this file and the password-manager copy makes backups unrecoverable.
RESTIC_PASSWORD_FILE=/etc/sia-planb/restic-password

# Backblaze B2 application key; only needed for the b2: backend.
# Create a key restricted to the backup bucket.
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=

# Uptime Kuma push monitor URL, e.g. https://kuma.example.com/api/push/TOKEN.
# Create a Push monitor (heartbeat slightly above 24h) and paste its URL here.
KUMA_PUSH_URL=

# Local staging directory for dumps and archives (optional).
BACKUP_ROOT=/var/lib/sia-planb/backups
