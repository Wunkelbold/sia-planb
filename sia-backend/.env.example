# Copy this file to .env for local development. Never commit the copy.

APP_ENV=development

# Local builds use these names. Production sets immutable GHCR image tags.
FLASK_IMAGE=sia-planb-flask:dev
DATABASE_IMAGE=sia-planb-database:dev

DATABASE_PASSWORD=change-me
DATABASE_HOST=database
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_USER=postgres

HOSTNAME=mail.example.test
hostname=mail.example.test
SSL_TYPE=self-signed

# Generate independent, stable values for every environment.
SECRET_KEY=replace-with-a-long-random-value
CAPTCHA_SECRET_KEY=replace-with-a-long-random-value
MAIL_PASSWORD=replace-with-the-noreply-mailbox-password

# Set true only for a one-time mailbox provisioning/update.
UPDATE_MAIL_USER=false

# Local development defaults. Production should use paths outside the Git checkout.
MAILSERVER_ENV_FILE=./mail-server/mailserver.env
MAIL_ACCOUNTS_FILE_HOST=./mail-server/docker-data/dms/config/postfix-accounts.cf
MAIL_DATA_PATH=./mail-server/docker-data/dms/mail-data
MAIL_STATE_PATH=./mail-server/docker-data/dms/mail-state
MAIL_LOG_PATH=./mail-server/docker-data/dms/mail-logs
MAIL_CONFIG_PATH=./mail-server/docker-data/dms/config
